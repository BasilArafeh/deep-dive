# Copy this file to .env and fill in your real keys for local development
# For production deployment on Railway, set these as environment variables in the Railway dashboard
# Never commit your real .env file — it is in .gitignore

# OpenAI — get your key at platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone — get your key at app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=deep-dive

# Tavily — get your key at app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith — get your key at smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=deep-dive

# App
ENVIRONMENT=development

# Frontend — your Vercel deployment URL (used for CORS in production)
FRONTEND_URL=your_vercel_url_here

# API Authentication — generate a strong random key and set it here
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_secret_api_key_here
